# Supabase Postgres connection string (Project Settings > Database > Connection string > URI)
# Use the "Transaction" pooler connection for serverless/Netlify deploys.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase project API (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage public bucket for property images
NEXT_PUBLIC_SUPABASE_IMAGES_BUCKET=property-images

# Resend (transactional email on new lead)
RESEND_API_KEY=
LEADS_NOTIFICATION_EMAIL=

# Used by the keep-alive GitHub Action to hit the deployed health endpoint
NEXT_PUBLIC_SITE_URL=http://localhost:3000

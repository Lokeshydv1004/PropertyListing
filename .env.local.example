# Supabase Postgres connection string — use the "Transaction pooler"
# connection (Project Settings > Database > Connection string), not
# "Direct connection". Required for serverless (Netlify) deploys.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres

# ── Company facts (T3/T4) ────────────────────────────────────────────────
# Used by lib/site-config.ts. Until these are set the site renders visibly
# unfinished placeholders rather than the fake "98765 43210" it used to.
NEXT_PUBLIC_CONTACT_PHONE="+91 00000 00000"
NEXT_PUBLIC_CONTACT_EMAIL="hello@gharshare.in"
# Digits only, country code included, no "+"
NEXT_PUBLIC_WHATSAPP="910000000000"
NEXT_PUBLIC_LEGAL_NAME="GharShare Technologies Pvt. Ltd."
NEXT_PUBLIC_CIN=""
NEXT_PUBLIC_ADDRESS=""
NEXT_PUBLIC_SITE_URL="https://gharshare.in"

# ── Lead alerting (C1) ───────────────────────────────────────────────────
# Any endpoint that accepts { "text": "..." } — a Slack incoming webhook, a
# Discord webhook, or a small relay in front of the Telegram bot API.
# Unset means notifications are skipped silently; leads still save.
LEAD_WEBHOOK_URL=""

# ── Analytics (C2) ───────────────────────────────────────────────────────
# Unset means no analytics script is injected at all.
NEXT_PUBLIC_GA_ID=""

# ── Admin console auth (Supabase Auth, magic links) ──────────────────────
# Project Settings > API. The publishable/anon key is safe in the browser;
# it is the URL and key the sign-in link flow uses. Unset means /admin
# returns an error rather than silently letting anyone in.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Two settings must be changed in the Supabase dashboard as well:
#   Authentication > URL Configuration > Redirect URLs
#     add https://gharshare.in/admin/auth/callback (and the localhost one)
#   Authentication > Sessions
#     JWT expiry 3600, refresh token reuse interval default, and set the
#     session timebox to 12 hours — a working day, not a standing risk on a
#     shared laptop.

# ── Admin console (Supabase Auth + Storage) ──────────────────────────────
# Project Settings > API Keys. The publishable key is browser-safe, which is
# why it carries the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# The secret key. Server-side only — it bypasses every row-level security
# rule, so it must NEVER be prefixed NEXT_PUBLIC_. Used solely for file
# uploads (lib/supabase/storage.ts is marked server-only, so a mistaken
# client import is a build error rather than a leak).
# Without it the console works except for uploads.
SUPABASE_SECRET_KEY=""
